{
  "name": "next-easytour",
  "version": "0.1.0",
  "description": "Lightweight interactive tutorial overlay for React and Next.js apps. Step-based guide with animated SVG arrows, highlighted target elements, circle annotations, and an optional visual editor for authoring tours directly in the running UI.",
  "keywords": [
    "tutorial",
    "onboarding",
    "walkthrough",
    "tour",
    "guide",
    "overlay",
    "nextjs",
    "react",
    "svg-arrow",
    "interactive"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "homepage": "",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css",
    "./src/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean && cp src/styles.css dist/styles.css",
    "dev": "tsup src/index.ts --format esm --dts --out-dir dist --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "lucide-react": ">=0.300.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "lucide-react": "^0.400.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}